<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:aissyst.desktop.ViewModels"
        xmlns:logging="using:aissyst.desktop.Logging"
        x:Class="aissyst.desktop.Views.MainWindow"
        x:DataType="vm:LogViewModel"
        Title="aissyst - Log"
        Width="800"
        Height="450"
        MinWidth="320"
        MinHeight="200">
    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="8">
        <WrapPanel Orientation="Horizontal">
            <ToggleButton x:Name="InfoFilter" Content="Info" IsChecked="{Binding ShowInfo, Mode=TwoWay}"
                          ToolTip.Tip="Show information messages" Margin="0,0,6,4" />
            <ToggleButton x:Name="WarningFilter" Content="Warning" IsChecked="{Binding ShowWarning, Mode=TwoWay}"
                          ToolTip.Tip="Show warnings" Margin="0,0,6,4" />
            <ToggleButton x:Name="ErrorFilter" Content="Error" IsChecked="{Binding ShowError, Mode=TwoWay}"
                          ToolTip.Tip="Show errors and critical messages" Margin="0,0,12,4" />
            <Button x:Name="CopyButton" Content="Copy" Click="CopyLog"
                    ToolTip.Tip="Copy the entire log, including hidden messages" Margin="0,0,6,4" />
            <Button x:Name="ClearButton" Content="Clear" Click="ClearLog"
                    ToolTip.Tip="Clear the entire log" Margin="0,0,6,4" />
            <Button x:Name="LatestButton" Content="Latest" Click="GoToLatest" IsVisible="False"
                    ToolTip.Tip="Jump to the latest entry and resume automatic scrolling" Margin="0,0,0,4" />
        </WrapPanel>
        <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Entries}"
                 Background="#1E1E1E" Foreground="White" BorderBrush="#444444" BorderThickness="1"
                 AutoScrollToSelectedItem="False" ScrollViewer.BringIntoViewOnFocusChange="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="logging:LogEntry">
                    <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                         TextWrapping="NoWrap" FontFamily="Menlo, Consolas, monospace" FontSize="12" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
