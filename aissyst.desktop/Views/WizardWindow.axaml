<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:aissyst.desktop.ViewModels"
        x:Class="aissyst.desktop.Views.WizardWindow"
        x:DataType="vm:WizardViewModel"
        Title="aissyst - Setup"
        Width="620" Height="520" MinWidth="620" MaxWidth="620" MinHeight="520" MaxHeight="520"
        WindowDecorations="BorderOnly" CanResize="False" CanMinimize="False" CanMaximize="False">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="WizardTitleBar" Height="36" Padding="16,0" Background="#20808080"
                PointerPressed="TitlePointerPressed">
            <TextBlock x:Name="WizardTitle" Text="aissyst - Setup" FontSize="14"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" />
            <Grid Grid.Row="2" IsEnabled="{Binding CanEdit}">
                <ScrollViewer x:Name="ChoicesScroll" IsVisible="{Binding IsChoicePage}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WizardOptionViewModel">
                                <RadioButton GroupName="WizardOptions" Margin="0,4"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Opacity="0.7" IsVisible="{Binding HasDescription}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid IsVisible="{Binding IsTemplatePath}" ColumnDefinitions="*,Auto"
                      ColumnSpacing="8" VerticalAlignment="Top">
                    <TextBox Text="{Binding Path, Mode=TwoWay}" PlaceholderText="Context template ZIP path" />
                    <Button Grid.Column="1" Content="Browse..." Click="BrowseClicked"
                            IsEnabled="{Binding !IsBrowsing}" />
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                           Foreground="Crimson" TextWrapping="Wrap" MaxHeight="100" />
                <TextBlock Text="{Binding Confirmation}" IsVisible="{Binding IsConfirming}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <StackPanel IsVisible="{Binding IsWorking}" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="StartupProgressBar" IsIndeterminate="{Binding IsIndeterminate}"
                                 Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="4" />
                </StackPanel>
                <Button x:Name="SecondaryButton" Grid.Column="1" Content="{Binding SecondaryLabel}"
                        IsVisible="{Binding HasSecondaryAction}" IsEnabled="{Binding CanNext}" Click="SecondaryClicked" />
                <Button x:Name="NextButton" Grid.Column="2" Content="{Binding NextLabel}" IsDefault="True" MinWidth="90"
                        IsEnabled="{Binding CanNext}" Click="NextClicked" />
            </Grid>
        </Grid>
    </Grid>
</Window>
