<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:aissyst.desktop.ViewModels"
        x:Class="aissyst.desktop.Views.DialogWindow"
        x:DataType="vm:DialogViewModel"
        Title="aissyst - Dialog" Width="560" Height="560" MinWidth="280" MinHeight="180"
        WindowStartupLocation="CenterScreen" Background="#101E3A" Topmost="True">
    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
    <ListBox x:Name="DialogList" ItemsSource="{Binding Entries}" Background="#101E3A"
             BorderThickness="0" AutoScrollToSelectedItem="False"
             ScrollViewer.BringIntoViewOnFocusChange="False"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DialogEntryViewModel">
                <StackPanel Margin="{Binding Spacing}" Spacing="6">
                    <TextBlock Text="{Binding Header}" Foreground="{Binding Foreground}" Opacity="0.7" FontSize="12" />
                    <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                         FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
</Window>
